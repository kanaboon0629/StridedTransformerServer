{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python デバッガー: 現在のファイル",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "python": "myvenv/bin/python3"
        },
        {
            "name": "Python デバッガー: vis.py with video",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/3d-human-pose-estimation/demo/vis.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/myvenv/bin/python3",
            "args": ["--video", "input_clip.mp4"]
        }
    ]
}
